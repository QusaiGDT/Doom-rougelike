[gd_scene format=3 uid="uid://cu2imn8jkn0pq"]

[sub_resource type="GDScript" id="GDScript_hwsm6"]
script/source = "extends Label3D

@export var float_speed: float = 1.5
@export var fade_duration: float = 0.6

func setup(amount: float) -> void:
	text = str(roundi(amount)) if amount == floor(amount) else \"%.1f\" % amount
	
	# Random X/Y scatter so multiple hits don't overlap directly
	position += Vector3(randf_range(-0.3, 0.3), randf_range(0.2, 0.5), 0.0)

	# 1. Grab the active camera
	var camera = get_viewport().get_camera_3d()
	if camera:
		# 2. Push the label 0.3 units along the direction vector toward the camera
		var dir_to_cam = (camera.global_position - global_position).normalized()
		global_position += dir_to_cam * 0.3

	# Animate float and fade
	var tween = create_tween().set_parallel(true)
	tween.tween_property(self, \"position:y\", position.y + 1.0, fade_duration)
	tween.tween_property(self, \"modulate:a\", 0.0, fade_duration)
	tween.chain().tween_callback(queue_free)
"

[node name="DamageLabel" type="Label3D" unique_id=888100682]
billboard = 2
font_size = 100
script = SubResource("GDScript_hwsm6")
fade_duration = 0.75
