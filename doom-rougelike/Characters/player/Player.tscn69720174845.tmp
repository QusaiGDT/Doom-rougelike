[sub_resource type="GDScript" id="GDScript_uhn5l"]
script/source = "extends Control

var current_weapon: WeaponBase

# 1. Accept any incoming mod drag data
func _can_drop_data(_at_position: Vector2, data: Variant) -> bool:
	return typeof(data) == TYPE_DICTIONARY and data.has(\"source_index\")

# 2. Delete the mod when dropped here
func _drop_data(_at_position: Vector2, data: Variant) -> void:
	if not is_instance_valid(current_weapon):
		return
		
	var source_idx: int = data[\"source_index\"]
	var mods: Array = current_weapon.active_mods
	
	if source_idx < mods.size():
		var mod_to_remove = mods.pop_at(source_idx)
		if is_instance_valid(mod_to_remove):
			mod_to_remove.queue_free()
			
		# Refresh the UI layout
		get_parent().setup_mod_buttons(current_weapon)
"

